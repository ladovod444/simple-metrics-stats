{
  "name": "ws-stat/simple-metrics-stats",
  "description": "Symfony data analytics and collection bundle",
  "type": "symfony-bundle",
  "license": "MIT",
    "authors": [
        {
            "name": "Dz",
            "email": "dz213456@example.com"
        }
    ],
  "keywords": ["symfony", "bundle", "search", "replace", "migration"],
  "require": {
    "php": ">=8.3",
    "symfony/framework-bundle": "^6.4|^7.0|^8.0",
    "symfony/console": "^6.4|^7.0|^8.0",
    "symfony/yaml": "^6.4|^7.0|^8.0",
    "doctrine/dbal": "^3.0|^4.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0|^11.0"
  },
  "autoload": {
    "psr-4": {
      "Ws\\SimpleMetricsStatsBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Ws\\SimpleMetricsStatsBundle\\Tests\\": "tests/"
    }
  },
  "extra": {
    "symfony": {
      "allow-contrib": false
    }
  }
}
